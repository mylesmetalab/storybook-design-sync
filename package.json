{
  "name": "@metalab/storybook-design-sync",
  "version": "0.0.32",
  "description": "Storybook 10 addon that detects drift between a story and its Figma counterpart.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@metalab/design-sync-core": "github:mylesmetalab/design-sync-core#v0.0.3",
    "@metalab/design-sync-pipeline": "github:mylesmetalab/design-sync-pipeline#v0.0.11",
    "ts-morph": "^28.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./preview": "./dist/preview.js",
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "design-sync": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.0.0",
    "tinyglobby": "^0.2.16",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  },
  "storybook": {
    "displayName": "Design Sync",
    "supportedFrameworks": [
      "*"
    ]
  }
}
